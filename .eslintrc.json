{
  "env": {
    "browser": true,
    "es2021": true,
    "webextensions": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "indent": "off",
    "linebreak-style": "off",
    "quotes": "off",
    "semi": "off",
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "error"
  },
  "globals": {
    "chrome": "readonly",
    "browser": "readonly",
    "module": "readonly",
    "exports": "readonly",
    "require": "readonly",
    "BugTracerStorage": "readonly",
    "UploadManager": "readonly",
    "BaseUploadProvider": "readonly",
    "CloudinaryProvider": "readonly",
    "AWSS3Provider": "readonly",
    "GenericHTTPProvider": "readonly"
  }
}
